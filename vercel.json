{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "talkify/wsgi.py": {
      "maxDuration": 60
    }
  },
  "builds": [
    {
      "src": "build_files.sh",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "staticfiles"
      }
    }
  ],
  "routes": [
    {
      "src": "/static/(.*)",
      "dest": "/staticfiles/$1"
    },
    {
      "src": "/(.*)",
      "dest": "talkify/wsgi.py"
    }
  ]
}
